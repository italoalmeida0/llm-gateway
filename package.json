{
  "name": "llm-gateway",
  "version": "1.0.0",
  "description": "Self-hosted LLM Gateway: multi-tenant API keys with budgets, proxying to one upstream OpenAI/Anthropic-compatible provider.",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch server/index.ts",
    "dev:web": "bun ./dev-web.ts 5700",
    "start": "bun server/index.ts",
    "build": "NODE_ENV=production bun ./build.ts",
    "test": "DATA_DIR=./data/test bun test",
    "bench": "bun ./test/bench.ts",
    "fake-upstream": "bun ./test/fake-upstream.ts",
    "seed": "NODE_ENV=development bun ./scripts/seed-usage.ts",
    "perf:sim": "bun ./scripts/perf-sim.ts",
    "perf:tuning": "bun ./scripts/perf-tuning.ts",
    "perf:router-bench": "bun ./scripts/perf-router-bench.ts",
    "clean": "rm -rf dist data",
    "fclean": "rm -rf dist data node_modules"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@opendocsg/pdf2md": "^0.3.0",
    "ag-grid-community": "31.1.1",
    "highlight.js": "^11.12.0",
    "magic-bytes.js": "^1.13.1",
    "marked": "^18.0.11",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "solid-ag-grid": "^0.0.230",
    "solid-charts": "0.0.2",
    "sortablejs": "^1.15.7",
    "streamdown-solid": "^0.0.3",
    "tokenx": "^2.1.0",
    "usal": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "babel-preset-solid": "^1.9.12",
    "postcss": "^8.5.26",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3"
  }
}
